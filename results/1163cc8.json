    {
      "part": "business_meaning",
      "applies_to": "column",
      "sentence": "A description passes when it gives the definition this business has agreed on for the column, which another company might define differently, and does more than restate the column name.",
      "rule": "The description has at least 2 content words that are not in the column name and are not filler. A key column must name the table it joins to.",
      "heuristic": true
    },
    {
      "part": "allowed_values",
      "applies_to": "column",
      "sentence": "A description passes when a categorical column lists every expected value and what each one means, and a numeric or date column states the range or kind of values to expect. A data type alone never passes.",
      "rule": "A column with an accepted_values test names every tested value in its description. A numeric or date column has a unit code in parentheses, a unit word, or an explicit range.",
      "heuristic": false
    },
    {
      "part": "interpretation_guidance",
      "applies_to": "column",
      "sentence": "A description passes when it says how to read the column correctly and names at least one case where the obvious reading is wrong.",
      "rule": "The description contains a caveat phrase: unless, except, excluding, does not include, not the same as, even if, only when.",
      "heuristic": true
    },
    {
      "part": "default_filter",
      "applies_to": "column",
      "sentence": "A description passes when it says which rows to include or exclude by default, and when to override that.",
      "rule": "The description has a filter phrase (filter to, exclude, include only, by default) and an override phrase (unless, except when, only if).",
      "heuristic": false
    },
    {
      "part": "not_applicable",
      "applies_to": "column",
      "sentence": "A key column skips allowed values and default filter, but it must still pass business meaning by saying what one row is and what the key joins to. A free-text column skips allowed values. Every other part applies to every column.",
      "rule": "A key column (unique plus not_null tests, or a relationships test) skips allowed values and default filter. A free-text column (varchar with no accepted_values test) skips allowed values.",
      "heuristic": false
    }
